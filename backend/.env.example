# ─────────────────────────────────────────────────────────────
# DevTrack backend configuration (Issue #19)
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# Port the API listens on
PORT=5000

# MongoDB connection string (Issue #9, decision: MongoDB per TDD section 3)
# Local:  mongodb://127.0.0.1:27017/devtrack
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/devtrack
DB_URI=mongodb://127.0.0.1:27017/devtrack

# JWT signing secret, HS256. Must be >= 32 characters (256 bits).
# Generate one with:  npm run gen:secret
JWT_SECRET=replace-with-a-64-char-random-hex-string

# ── Optional ────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# Browser origin(s) allowed by CORS. Comma-separate for several.
CLIENT_ORIGIN=http://localhost:5173

# bcrypt work factor (SEC-01 requires >= 10). Default 12.
BCRYPT_ROUNDS=12
